APP_ENV=development
LOG_LEVEL=INFO

# Async driver is required (postgresql+asyncpg://), not plain postgresql://
DATABASE_URL=postgresql+asyncpg://localhost/jenie_dev

# Used only by the test suite
JENIE_TEST_DATABASE_URL=postgresql+asyncpg://localhost/jenie_test

# Populated in later milestones
JENIE_DEFAULT_ORG_ID=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
BLUEBUBBLES_BASE_URL=
BLUEBUBBLES_PASSWORD=
